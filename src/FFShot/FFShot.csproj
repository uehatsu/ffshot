<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/ffshot.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>ffshot</AssemblyName>
    <RootNamespace>FFShot</RootNamespace>
    <Version>0.2.3</Version>
    <!-- exe のプロパティ（詳細タブ）に表示される情報 -->
    <Product>First Fox Screenshot</Product>
    <AssemblyTitle>First Fox Screenshot (ffshot)</AssemblyTitle>
    <Description>タスクトレイに常駐し、ホットキーで PNG スクリーンショットを保存します。</Description>
    <Authors>Hatsuhito UENO</Authors>
    <Company>uehatsu.info</Company>
    <Copyright>Copyright © 2026 Hatsuhito UENO</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- dotnet publish 用: ランタイム同梱の単一 exe -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.*" PrivateAssets="all" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/ffshot.ico" LogicalName="ffshot.ico" />
    <None Include="Assets/icon-source.jpg" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FFShot.Tests" />
  </ItemGroup>

</Project>
